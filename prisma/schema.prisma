generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  admin
  customer
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum EnquiryType {
  PACKAGE
  DESTINATION
  CUSTOM_TRIP
  CONTACT
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

enum WishlistItemType {
  DESTINATION
  PACKAGE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  role         AppRole @default(customer)

  fullName       String
  phone          String?
  whatsapp       String?
  timezone       String  @default("Asia/Kolkata")
  state          String?
  city           String?
  pincode        String?
  marketingOptIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries    Enquiry[]
  wishlist     WishlistItem[]
  enquiryNotes EnquiryNote[]
  reviews      Review[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Destination {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  country String
  region  String?
  slug    String  @unique

  summary     String @default("")
  description String @default("")

  bestMonths Int[]    @default([])
  tags       String[] @default([])

  sortOrder   Int       @default(0)
  isPublished Boolean   @default(false)
  archivedAt  DateTime?

  heroImageUrl      String?
  heroImagePublicId String?
  heroImageAlt      String?

  images String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages  Package[]
  enquiries Enquiry[]
  blogPosts BlogPost[]
  wishlists WishlistItem[]
  reviews   Review[]

  @@index([isPublished, sortOrder])
  @@index([country])
  @@index([region])
  @@index([archivedAt])
  @@map("destinations")
}

model Package {
  id    String @id @default(uuid()) @db.Uuid
  title String
  slug  String @unique

  destinationId String? @db.Uuid

  currency       String @default("INR")
  durationDays   Int    @default(1)
  durationNights Int    @default(0)

  priceFrom Decimal? @db.Decimal(12, 2)

  tripStyle  String?
  categories String[] @default([])

  summary     String @default("")
  description String @default("")

  highlights String[] @default([])
  inclusions String[] @default([])
  exclusions String[] @default([])

  itinerary Json @default("[]")
  gallery   Json @default("[]")

  isFeatured  Boolean   @default(false)
  isPublished Boolean   @default(false)
  archivedAt  DateTime?

  heroImageUrl      String?
  heroImagePublicId String?
  heroImageAlt      String?

  images String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  enquiries          Enquiry[]
  wishlists          WishlistItem[]
  recommendedInBlogs BlogPost[]
  reviews            Review[]

  @@index([isPublished, isFeatured])
  @@index([destinationId])
  @@index([tripStyle])
  @@index([archivedAt])
  @@map("packages")
}

model BlogPost {
  id String @id @default(uuid()) @db.Uuid

  title String
  slug  String @unique

  authorName String @default("The Travel Beats")

  excerpt String @default("")
  body    String @default("")

  tags           String[] @default([])
  readingMinutes Int      @default(5)

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  archivedAt  DateTime?

  destinationId String? @db.Uuid

  coverImageUrl      String?
  coverImagePublicId String?
  coverImageAlt      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  recommendedPackages Package[]

  @@index([isPublished, publishedAt])
  @@index([destinationId])
  @@index([archivedAt])
  @@map("blog_posts")
}

model Enquiry {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique

  userId String @db.Uuid

  destinationId String? @db.Uuid
  packageId     String? @db.Uuid

  type   EnquiryType
  status EnquiryStatus @default(NEW)

  source   String @default("website")
  currency String @default("INR")

  budgetMin Decimal? @db.Decimal(12, 2)
  budgetMax Decimal? @db.Decimal(12, 2)

  travelStart DateTime?
  travelEnd   DateTime?

  travellersAdults   Int?
  travellersChildren Int?

  message String?

  contactSnapshot Json @default("{}")
  tripDetails     Json @default("{}")

  followUpAt DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  notes         EnquiryNote[]
  notifications NotificationOutbox[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([destinationId])
  @@index([packageId])
  @@index([followUpAt])
  @@map("enquiries")
}

model EnquiryNote {
  id        String  @id @default(uuid()) @db.Uuid
  enquiryId String  @db.Uuid
  authorId  String? @db.Uuid

  body String

  createdAt DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
  @@index([authorId])
  @@map("enquiry_notes")
}

model NotificationOutbox {
  id String @id @default(uuid()) @db.Uuid

  enquiryId String? @db.Uuid

  kind      String
  recipient String

  payload Json @default("{}")

  status OutboxStatus @default(PENDING)

  attempts  Int     @default(0)
  lastError String?

  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiry Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([enquiryId])
  @@map("notification_outbox")
}

model WishlistItem {
  id String @id @default(uuid()) @db.Uuid

  userId   String           @db.Uuid
  itemType WishlistItemType

  destinationId String? @db.Uuid
  packageId     String? @db.Uuid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@unique([userId, packageId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

model RateLimitHit {
  bucket      String
  identifier  String
  windowStart DateTime
  hits        Int      @default(1)

  @@id([bucket, identifier, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}

model Review {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  destinationId String? @db.Uuid
  packageId     String? @db.Uuid

  rating  Int
  title   String?
  comment String

  status ReviewStatus @default(PENDING)

  adminReply String?
  repliedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  package     Package?     @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([destinationId, status])
  @@index([packageId, status])
  @@index([status, createdAt])
  @@map("reviews")
}
